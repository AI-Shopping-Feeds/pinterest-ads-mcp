# Copy to .env (gitignored) or ~/.pinterest-ads-mcp/.env and fill in. Never commit real values.

# --- Required ---

# Your Pinterest app (developers.pinterest.com -> My apps -> Manage -> Configure).
PINTEREST_ADS_APP_ID=
PINTEREST_ADS_APP_SECRET=

# --- Refresh token (set ONE of these, or neither if you use the default file) ---

# `pinterest-ads-mcp auth` saves the refresh token here (default
# ~/.pinterest-ads-mcp/secrets/pinterest-ads-token.json, owner-only permissions).
PINTEREST_ADS_TOKEN_FILE=
# Or put the refresh token itself here (starts with pinr_). Prefer the file: the server can
# then save the renewed token each time it refreshes.
PINTEREST_ADS_REFRESH_TOKEN=
# Or, to try the server without OAuth, a test access token from My apps (a Sandbox token
# lasts 30 days; a production test token 24 hours and only reads Pins, boards and the user).
PINTEREST_ADS_ACCESS_TOKEN=

# --- Optional ---

# Default ad account (pinterest_ads_list_ad_accounts shows them). Tools also take ad_account_id.
PINTEREST_ADS_AD_ACCOUNT_ID=

# Use Pinterest's Sandbox (api-sandbox.pinterest.com) instead of production.
PINTEREST_ADS_SANDBOX=false

# Start in dry-run: writes are logged and previewed but NOT sent to Pinterest.
PINTEREST_ADS_DRY_RUN=true

# Register only read-only tools (lists, analytics, reports).
PINTEREST_ADS_READ_ONLY=false

# Only register some tool groups, e.g. accounts,campaigns,ad_groups,ads,analytics,reporting
PINTEREST_ADS_TOOL_GROUPS=

# Safety limits: writes beyond these need confirm='APPLY'.
PINTEREST_ADS_BULK_THRESHOLD=10
PINTEREST_ADS_MAX_INCREASE_PCT=20
# Optional absolute caps in the ad account's currency (blank = no cap).
PINTEREST_ADS_MAX_BUDGET=
PINTEREST_ADS_MAX_BID=

# Audit log of writes (default ~/.pinterest-ads-mcp/logs/audit.jsonl), how many days to keep
# entries (0 = forever) and whether to keep the old values of changed fields.
PINTEREST_ADS_AUDIT_LOG=
PINTEREST_ADS_AUDIT_RETENTION_DAYS=30
PINTEREST_ADS_AUDIT_SNAPSHOTS=true

# Largest report or bulk export the server will download, in MB.
PINTEREST_ADS_MAX_DOWNLOAD_MB=200

# Results per page for list calls (max 250) and per-request timeout in seconds.
PINTEREST_ADS_PAGE_SIZE=100
PINTEREST_ADS_TIMEOUT=30

PINTEREST_ADS_LOG_LEVEL=INFO

# Transport: stdio (default) or streamable-http (served at /mcp). HTTP has no sign-in: keep it
# on 127.0.0.1. Other addresses are refused unless PINTEREST_ADS_ALLOW_REMOTE=true.
PINTEREST_ADS_TRANSPORT=stdio
PINTEREST_ADS_HOST=127.0.0.1
PINTEREST_ADS_PORT=8000
PINTEREST_ADS_ALLOW_REMOTE=false

# Move the per-user folder (secrets/, logs/, .env) somewhere else.
PINTEREST_ADS_HOME=
